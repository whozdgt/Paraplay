// Windows resources: the program's icon and the version Explorer shows in its Properties box.
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/packaging/windows/musicplayer.ico"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "Paraplay\0"
      VALUE "FileDescription", "Paraplay music player\0"
      VALUE "FileVersion", "@PROJECT_VERSION@\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
      VALUE "OriginalFilename", "musicplayer.exe\0"
      VALUE "LegalCopyright", "MIT licence\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
